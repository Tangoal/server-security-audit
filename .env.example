# Configuration de audit.sh — un .env par serveur, jamais commité.
# Copier en `.env` à côté du script, puis `chmod 600 .env` (il contient une clé API).
#
# ⚠️ Toujours des chemins ABSOLUS : le service systemd tourne en root, `~` y
# pointe vers /root et pas vers le home de l'utilisateur du serveur.

# --- Identité --------------------------------------------------------------
# Nom du serveur affiché dans le rapport et l'objet du mail. Défaut : `hostname -s`.
SERVER_LABEL=

# --- Contexte donné à l'analyse --------------------------------------------
# Documents décrivant l'architecture de CE serveur, inclus dans le prompt s'ils
# existent (un chemin absent est simplement ignoré). Ils évitent les faux
# positifs sur des choix assumés et documentés (ports ouverts volontairement,
# services exposés, comptes de service…).
CONTEXT_FILES=/home/utilisateur/CLAUDE.md,/home/utilisateur/workspace/docs/INFRA.md

# Chemins où vivent les secrets du serveur. L'audit y vérifie les PERMISSIONS
# des fichiers sensibles (.env, *.key, *.pem, jetons, clés SSH) — jamais leur
# contenu, rien de secret ne part dans le prompt ni dans le mail.
SENSITIVE_PATHS=/home/utilisateur/.ssh,/home/utilisateur/workspace,/etc/ssl/private

# --- Exécution -------------------------------------------------------------
# Chemin du binaire `claude`. À renseigner : il vit dans le home de
# l'utilisateur et n'est pas dans le PATH d'un service systemd lancé en root.
CLAUDE_BIN=/home/utilisateur/.local/bin/claude

# Utilisateur dont la session `claude` est authentifiée. Le service tourne en
# root (pour lire iptables, /etc/shadow, les journaux), mais l'appel à claude
# redescend sur cet utilisateur : sinon claude ne trouve pas ses identifiants,
# et il sèmerait des fichiers root dans son ~/.claude.
CLAUDE_RUN_AS=utilisateur

# Modèle à utiliser (vide = celui configuré dans les réglages de claude).
AUDIT_MODEL=

# Secondes avant d'abandonner l'analyse. Défaut : 900.
AUDIT_TIMEOUT=900

# Dossier des rapports. Défaut : `reports/` à côté du script — donc embarqué
# par la sauvegarde quotidienne du dossier de travail, sans mécanisme dédié.
REPORTS_DIR=

# Jours de conservation des rapports sur la machine (ils restent dans les
# sauvegardes au-delà). Défaut : 60.
REPORT_RETENTION=60

# --- Envoi du rapport (Resend) ---------------------------------------------
# Le rapport part par mail à CHAQUE run, quel que soit le verdict : c'est aussi
# le signal de bonne santé de l'audit (pas de mail = l'audit ne tourne plus).
RESEND_API_KEY=
ALERT_EMAIL_TO=moi@example.com
# Doit appartenir à un domaine vérifié dans Resend. `onboarding@resend.dev`
# (défaut) n'écrit qu'au titulaire du compte Resend — suffisant ici.
ALERT_EMAIL_FROM=onboarding@resend.dev
